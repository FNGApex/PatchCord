<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PatchCord.Mac</AssemblyName>
    <RootNamespace>PatchCord</RootNamespace>
    <!-- Avalonia is the first (and only) NuGet dep; lives ONLY in this project. -->
    <!-- Core and the Windows shell stay zero-NuGet. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12.0.4 — first stable release with a net10.0 dependency group. -->
    <PackageReference Include="Avalonia"               Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop"       Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PatchCord.Core\PatchCord.Core.csproj" />
  </ItemGroup>

  <!-- Embed tray icon and font assets as Avalonia resources. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- U1: palette brush keys + keyed ControlThemes -->
    <AvaloniaResource Include="Styles.axaml" />
  </ItemGroup>

</Project>

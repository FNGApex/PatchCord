<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PatchCord.MainWindow"
        Title="PatchCord"
        Width="900"
        Height="620"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <Border Margin="0" CornerRadius="8">

    <Grid RowDefinitions="50,Auto,*">

      <!-- ── Title bar ──────────────────────────────────────────────────── -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Accent}"/>
          <TextBlock Text="PATCH" FontSize="14" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Text}"
                     FontFamily="{StaticResource SpaceGrotesk}"/>
          <TextBlock Text="CORD"  FontSize="14" FontWeight="Bold" Margin="3,0,0,0"  VerticalAlignment="Center"
                     Foreground="{DynamicResource Accent}"
                     FontFamily="{StaticResource SpaceGrotesk}"/>
        </StackPanel>
      </Grid>

      <!-- ── Tab bar ────────────────────────────────────────────────────── -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,2,0,8">
        <Button x:Name="TabStatusBtn"
                Content="Status"
                Margin="0,0,24,0"
                Theme="{StaticResource TabButton}"/>
        <Button x:Name="TabOptionsBtn"
                Content="Options"
                Theme="{StaticResource TabButton}"/>
      </StackPanel>

      <!-- ── Tab content ────────────────────────────────────────────────── -->
      <Grid Grid.Row="2">

        <!-- STATUS TAB -->
        <ScrollViewer x:Name="StatusScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,2,20,18">
          <StackPanel>

            <!-- Monitoring header -->
            <Grid Margin="2,8,0,8">
              <StackPanel>
                <TextBlock Text="Monitoring" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource Sub}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5"
                          Background="#23A55A" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StatusText" Text="Active"
                             FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0"
                             Foreground="{DynamicResource Text}"/>
                </StackPanel>
                <TextBlock x:Name="StatusSub"
                           Text="Watching for Discord instances that need re-patching..."
                           FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource Sub}"/>
              </StackPanel>
              <!-- BtnToggle: Theme swapped between AccentPill and OnPill in code-behind -->
              <Button x:Name="BtnToggle" Content="Turn Off"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="112"
                      Theme="{StaticResource AccentPill}"/>
            </Grid>

            <!-- Mod-missing warning -->
            <Border x:Name="ModWarn"
                    IsVisible="False"
                    Margin="0,12,0,0" Padding="14,11" CornerRadius="6"
                    Background="#1F1A0A" BorderBrush="#FAA61A" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⚠" Foreground="#FAA61A" FontSize="15" FontWeight="Bold"
                             VerticalAlignment="Top" Margin="0,0,10,0"/>
                  <TextBlock x:Name="ModWarnText" Foreground="#FAD27A" FontSize="12.5"
                             TextWrapping="Wrap" MaxWidth="620"/>
                </StackPanel>
                <Button x:Name="BtnGetMod" Grid.Column="1" Content="Get Vencord"
                        VerticalAlignment="Center" Margin="14,0,0,0"
                        Theme="{StaticResource WarnPill}"/>
              </Grid>
            </Border>

            <!-- Install list -->
            <TextBlock Text="Discord installs" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="2,24,0,10"/>
            <StackPanel x:Name="InstallList"/>

            <!-- Refresh button -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="10">
              <Button x:Name="BtnRefresh" Content="Refresh"
                      Theme="{StaticResource GhostPill}"/>
            </StackPanel>

            <!-- Patch history -->
            <TextBlock Text="Recent patches" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="2,24,0,10"/>
            <StackPanel x:Name="HistoryPanel"/>

          </StackPanel>
        </ScrollViewer>

        <!-- OPTIONS TAB -->
        <ScrollViewer x:Name="OptionsScroll"
                      IsVisible="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,2,20,18">
          <StackPanel>

            <!-- Client mod chooser -->
            <TextBlock Text="Client mod" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,4,0,6"/>
            <TextBlock Text="Sets the mod for all your installs. To run a different mod on a specific install, change it on that install in the Status tab. OpenAsar (below) is separate and stacks under any mod."
                       FontSize="12" TextWrapping="Wrap" MaxWidth="600"
                       Foreground="{DynamicResource Sub}"
                       HorizontalAlignment="Left" Margin="4,0,0,12"/>
            <StackPanel x:Name="ClientModPanel" Spacing="9"/>

            <!-- OpenAsar -->
            <TextBlock Text="OpenAsar" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,28,0,8"/>
            <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" MaxWidth="620">
                <TextBlock Text="Keep OpenAsar installed" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
                <TextBlock Text="Open-source replacement for Discord's app.asar (by GooseMod) — faster, lighter startup. Stacks under whichever mod you pick."
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource Sub}"/>
              </StackPanel>
              <Button x:Name="BtnOpenAsar" Grid.Column="1" Content="Off"
                      VerticalAlignment="Top"
                      Theme="{StaticResource SmallToggle}"/>
            </Grid>

            <!-- Run at startup -->
            <TextBlock Text="Startup" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,28,0,8"/>
            <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" MaxWidth="620">
                <TextBlock Text="Run at startup" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
                <TextBlock Text="Open PatchCord automatically when you sign in, so it's always keeping your mod patched."
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource Sub}"/>
              </StackPanel>
              <Button x:Name="BtnStartup" Grid.Column="1" Content="Off"
                      VerticalAlignment="Top"
                      Theme="{StaticResource SmallToggle}"/>
            </Grid>

            <!-- Permissions (B3.9) -->
            <TextBlock Text="Permissions" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,28,0,8"/>
            <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" MaxWidth="620">
                <TextBlock Text="Full Disk Access / App Management" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"/>
                <TextBlock Text="PatchCord needs App Management (or Full Disk Access) to patch Discord's app bundle on macOS. Grant it once in System Settings. Click to check guidance."
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource Sub}"/>
              </StackPanel>
              <Button x:Name="BtnCheckPermissions" Grid.Column="1" Content="Check"
                      Width="70"
                      VerticalAlignment="Top"
                      Theme="{StaticResource CheckButton}"/>
            </Grid>

            <!-- Check interval -->
            <TextBlock Text="Check interval" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,28,0,8"/>
            <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Text="How often to check your installs for re-patching"
                         FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sub}"/>
              <TextBlock x:Name="LblInterval" Grid.Column="1" FontSize="12"
                         Foreground="{DynamicResource Text}"
                         HorizontalAlignment="Right"/>
            </Grid>
            <Slider x:Name="SliderInterval"
                    Minimum="5" Maximum="120" TickFrequency="5"
                    IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

            <!-- Appearance & notifications (expanded inline) -->
            <TextBlock Text="Appearance &amp; notifications" FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource Sub}"
                       Margin="4,28,0,14"/>

            <!-- Show notifications -->
            <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Text="Show notifications" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}"
                         VerticalAlignment="Center"/>
              <Button x:Name="BtnNotifyToggle" Grid.Column="1" Content="On"
                      Theme="{StaticResource SmallToggle}"/>
            </Grid>

            <!-- Theme chooser -->
            <TextBlock Text="Theme" FontSize="12"
                       Foreground="{DynamicResource Sub}"
                       Margin="0,18,0,9"/>
            <StackPanel x:Name="ThemePanel" Orientation="Horizontal" Spacing="8"/>

            <!-- Notification style -->
            <TextBlock Text="Notification style" FontSize="12"
                       Foreground="{DynamicResource Sub}"
                       Margin="0,18,0,9"/>
            <StackPanel x:Name="StylePanel" Orientation="Horizontal" Spacing="8"/>

            <!-- Notification size -->
            <Grid Margin="0,18,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Text="Notification size" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sub}"/>
              <TextBlock x:Name="LblNotifyScale" Grid.Column="1" FontSize="12"
                         Foreground="{DynamicResource Text}"/>
            </Grid>
            <Slider x:Name="SliderNotifyScale"
                    Minimum="70" Maximum="150" TickFrequency="5"
                    IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

            <!-- Notification duration -->
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Text="Notification duration" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sub}"/>
              <TextBlock x:Name="LblNotifyDur" Grid.Column="1" FontSize="12"
                         Foreground="{DynamicResource Text}"/>
            </Grid>
            <Slider x:Name="SliderNotifyDur"
                    Minimum="3" Maximum="15" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Border>

</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PatchCord.InstallRow">

  <Border Padding="2,12" BorderBrush="#3A3C42" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto">

      <!-- Left: name + badges + path -->
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <!-- Install name -->
          <TextBlock x:Name="RowName"
                     FontSize="14" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <!-- Primary badge (mod status) -->
          <Border x:Name="RowBadge"
                  CornerRadius="4" Padding="8,3" Margin="9,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="False">
            <TextBlock x:Name="RowStatus"
                       Foreground="White" FontSize="10" FontWeight="Bold"/>
          </Border>
          <!-- OpenAsar badge -->
          <Border x:Name="RowOpenAsarBadge"
                  CornerRadius="4" Padding="8,3" Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="False">
            <TextBlock x:Name="RowOpenAsarStatus"
                       Foreground="White" FontSize="10" FontWeight="Bold"/>
          </Border>
        </StackPanel>
        <!-- Path -->
        <TextBlock x:Name="RowPath"
                   FontSize="11" Margin="0,5,0,0"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="320"/>
      </StackPanel>

      <!-- Right: mod picker + toggle + remove -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">

        <!-- Per-install mod button -->
        <Button x:Name="RowModBtn"
                MinWidth="118" Height="30"
                FontSize="11" FontWeight="SemiBold"
                CornerRadius="5"/>

        <!-- Enabled/Paused toggle -->
        <Button x:Name="RowToggle"
                Width="96" Height="30"
                FontSize="11" FontWeight="SemiBold"
                CornerRadius="5"/>

        <!-- Remove (custom installs only) -->
        <Button x:Name="RowRemove"
                Width="30" Height="30"
                Content="✕" FontSize="12"
                CornerRadius="5"
                Background="Transparent"/>

      </StackPanel>
    </Grid>
  </Border>

</UserControl>

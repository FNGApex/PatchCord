<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PatchCord.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- Tray icon — macOS NSStatusItem. Menu actions wired in App.axaml.cs. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray-icon.png"
                      ToolTipText="PatchCord">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <!-- Header status line (disabled label, updated in code) -->
                        <NativeMenuItem Header="PatchCord" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <!-- Show the main window -->
                        <NativeMenuItem Header="Open PatchCord" />
                        <!-- Pause / Resume monitoring (label toggled in code) -->
                        <NativeMenuItem Header="Pause monitoring" />
                        <NativeMenuItemSeparator />
                        <!-- Test notification affordance -->
                        <NativeMenuItem Header="Test notification" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
